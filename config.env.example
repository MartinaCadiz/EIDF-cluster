# Copy to config.env and edit:  cp config.env.example config.env
# config.env is gitignored, so your personal settings stay out of the repo.

NAMESPACE=eidf029ns
QUEUE=eidf029ns-user-queue

# Prefix for job names and the eidf/user label (defaults to your login name)
EIDF_USER=${USER}

# Your PersistentVolumeClaim (list them with: kubectl -n eidf029ns get pvc)
PVC_NAME=CHANGE-ME
MOUNT_PATH=/mnt/data

# Container image for training jobs
IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

# GPU type and resources (see README for the GPU product names)
GPU_PRODUCT=NVIDIA-A100-SXM4-40GB
GPU_COUNT=1
CPU=8
MEMORY=32Gi
